<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/purple_500"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:text="BFit Widget"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_calories"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_title"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:text="Calories: 0"
        android:textColor="@color/white"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/widget_protein"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_calories"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="4dp"
        android:text="Protein: 0g"
        android:textColor="@color/white"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/widget_carbs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_protein"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="4dp"
        android:text="Carbs: 0g"
        android:textColor="@color/white"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/widget_fat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_carbs"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="4dp"
        android:text="Fat: 0g"
        android:textColor="@color/white"
        android:textSize="16sp" />

    <Button
        android:id="@+id/widget_update_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_fat"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:text="Update"
        android:backgroundTint="@color/purple_700"
        android:textColor="@color/white" />

</RelativeLayout> 