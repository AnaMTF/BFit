<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_login">

    <fragment
        android:id="@+id/nav_home"
        android:name="proiect.pdm.bfit.ui.dashboard.DashboardFragment"
        android:label="@string/menu_dashboard"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/nav_add_daily_stats"
        android:name="proiect.pdm.bfit.ui.addstats.AddDailyStatsFragment"
        android:label="Adaugă date"
        tools:layout="@layout/fragment_add_daily_stats" />

    <fragment
        android:id="@+id/nav_gallery"
        android:name="proiect.pdm.bfit.ui.gallery.GalleryFragment"
        android:label="@string/menu_gallery"
        tools:layout="@layout/fragment_gallery" />

    <fragment
        android:id="@+id/nav_gym_map"
        android:name="proiect.pdm.bfit.ui.gym_map.GymMapFragment"
        android:label="@string/gym_map"
        tools:layout="@layout/fragment_gym_map" />

    <fragment
        android:id="@+id/nav_slideshow"
        android:name="proiect.pdm.bfit.ui.slideshow.SlideshowFragment"
        android:label="@string/menu_slideshow"
        tools:layout="@layout/fragment_slideshow" />

    <fragment
        android:id="@+id/nav_register"
        android:name="proiect.pdm.bfit.ui.register.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_nav_register_to_nav_initialdetails"
            app:destination="@id/nav_initialdetails" />
    </fragment>
    <fragment
        android:id="@+id/nav_initialdetails"
        android:name="proiect.pdm.bfit.ui.initial_details.InitialDetailsFragment"
        android:label="Initial Details About You"
        tools:layout="@layout/fragment_initial_details" />

    <fragment
        android:id="@+id/nav_login"
        android:name="proiect.pdm.bfit.ui.login.LoginFragment"
        android:label="Log into Your Account"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_nav_register"
            app:destination="@id/nav_register" />
    </fragment>

    <fragment
        android:id="@+id/nav_about_app"
        android:name="proiect.pdm.bfit.ui.about_app.AboutAppFragment"
        android:label="@string/about_app"
        tools:layout="@layout/fragment_about_app" />
</navigation>